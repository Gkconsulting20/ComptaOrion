{
  "name": "comptaorion",
  "version": "1.0.0",
  "description": "ComptaOrion - ERP Léger pour l'Afrique",
  "main": "backend/src/main.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "cd backend && node src/main.js",
    "build": "npm run build --prefix frontend",
    "install:all": "npm ci --include=dev --prefix frontend && npm ci --include=dev --prefix backend",
    "postinstall": "npm run install:all",
    "test": "npm test --prefix frontend && npm test --prefix backend",
    "dev": "bash start.sh",
    "test:functional": "ERP_FUNCTIONAL_TEST=1 node --test backend/test/functional.test.js",
    "test:worker": "ERP_TEST_WORKER=1 npm run test:functional",
    "test:cloudflare": "node cloudflare/smoke-test.mjs",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run --outdir generated-artifacts/worker",
    "cloudflare:deploy": "npm run build && wrangler deploy"
  },
  "keywords": [
    "erp",
    "accounting",
    "africa",
    "syscohada"
  ],
  "author": "GKConsulting",
  "license": "ISC",
  "dependencies": {
    "recharts": "^3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
